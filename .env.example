# ──────────────────────────────────────────────────────────────────────────────
# Backend — Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env with real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/ebook_store

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cashfree ──────────────────────────────────────────────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'sandbox' for testing, 'production' for live payments
CASHFREE_ENV=sandbox

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of the frontend — used to lock CORS to a single origin
CLIENT_URL=http://localhost:5173
