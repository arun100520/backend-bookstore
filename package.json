{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "test:cashfree": "npm run build && node --test dist/services/cashfreeService.test.js",
    "test:cashfree:sandbox": "npm run build && node dist/scripts/testCashfree.js",
    "test:checkout": "npm run build && node --test dist/controllers/checkoutController.test.js dist/services/cashfreeService.test.js",
    "test:checkout:sandbox": "npm run build && node dist/scripts/testCheckout.js",
    "test:projection": "npm run build && node --test dist/services/orderProjection.test.js",
    "test:projection:db": "npm run build && node dist/scripts/testOrderProjection.js",
    "test:webhooks": "npm run build && node --test dist/controllers/webhookController.test.js dist/controllers/checkoutController.test.js dist/services/orderProjection.test.js dist/services/cashfreeService.test.js",
    "test:webhooks:db": "npm run build && node dist/scripts/testCashfreeWebhook.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cashfree-pg": "^6.0.6",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
